# Generated by Ansible - SSL with domain
upstream php-fpm {
    server unix:/run/php/php{{ php__version }}-fpm.sock;
}

server {
    listen 80;
    server_name {{ ieducar__name_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ ieducar__name_domain }};

    root {{ ieducar__base_path }}/public;
    index index.php index.html;

    {% if ieducar__use_letsencrypt | bool %}

    ssl_certificate /etc/letsencrypt/live/{{ ieducar__name_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ ieducar__name_domain }}/privkey.pem;

    {% else %}

    ssl_certificate {{ ieducar__ssl_certificate_path }};
    ssl_certificate_key {{ ieducar__ssl_certificate_key_path }};
    
    {% endif %}

    include snippets/ieducar-location-snippets.conf;
}
