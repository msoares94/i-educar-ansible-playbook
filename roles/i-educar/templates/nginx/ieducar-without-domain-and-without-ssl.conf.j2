# Generated by Ansible - HTTP with IP only
upstream php-fpm {
    server unix:/run/php/php{{ php__version }}-fpm.sock;
}

server {
    listen 80 default_server;
    server_name {{ ieducar__name_domain | default('_') }};

    root {{ ieducar__base_path }}/public;
    index index.php index.html;

    include snippets/ieducar-location-snippets.conf;
}
